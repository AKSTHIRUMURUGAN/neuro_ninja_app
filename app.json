{
  "expo": {
    "name": "NeuroNinja",
    "slug": "neuro-ninja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neuroninja",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.neuroninja.app",
      "appleTeamId": "YOUR_TEAM_ID",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.neuroninja.app.blocker"
        ]
      }
    },
    "android": {
      "package": "com.neuroninja.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "QUERY_ALL_PACKAGES",
        "PACKAGE_USAGE_STATS",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK",
        "CAMERA",
        "ACTIVITY_RECOGNITION",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_CONTACTS",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon.png",
          "color": "#00E699"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NeuroNinja to use the camera only when QR/barcode or location photo alarm missions are configured."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow NeuroNinja to use motion sensors when shake or step alarm missions are active."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow NeuroNinja to view your calendar only after you connect an external calendar."
        }
      ],
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D16",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 90
        }
      ],
      [
        "expo-app-blocker",
        {
          "ios": {
            "appGroup": "group.com.neuroninja.app.blocker",
            "shield": {
              "title": "NeuroNinja Shield",
              "subtitle": "{appName} is sealed to protect your focus.",
              "primaryButtonLabel": "Breach with Challenge",
              "secondaryButtonLabel": "Return to Focus",
              "primaryButtonColor": "#10B981",
              "titleColor": "#F8FAFC",
              "subtitleColor": "#94A3B8",
              "backgroundColor": "#090D16",
              "backgroundBlurStyle": "systemThickMaterialDark",
              "tempUnlockTitle": "Focus Released",
              "tempUnlockSubtitle": "Your earned time is ready. Breathe & be mindful.",
              "tempUnlockButtonLabel": "Enter App"
            },
            "notification": {
              "title": "NeuroNinja Focus Guard",
              "body": "Tap to enter the Dojo and claim an unlocked focus window."
            }
          },
          "android": {
            "notificationTitle": "NeuroNinja Focus Shield Active",
            "notificationText": "Monitoring distraction barriers."
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "DeviceActivityMonitor",
                  "bundleIdentifier": "com.neuroninja.app.DeviceActivityMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.neuroninja.app.blocker"
                    ]
                  }
                },
                {
                  "targetName": "ShieldAction",
                  "bundleIdentifier": "com.neuroninja.app.ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.neuroninja.app.blocker"
                    ]
                  }
                },
                {
                  "targetName": "ShieldConfiguration",
                  "bundleIdentifier": "com.neuroninja.app.ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.neuroninja.app.blocker"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
